# انسخ هذا الملف إلى .env محلياً واستبدل القيمة الوهمية بمفتاحك الخاص.
# لا تضع أي مفتاح حقيقي في Git أو README أو رسائل الدردشة.
OPENAI_API_KEY=your_api_key_here
DEFAULT_MODEL=gpt-4o-mini
HUB_PORT=8000
# مطلوب فقط عند تشغيل HTTP API؛ أنشئ token عشوائياً طويلاً محلياً.
HUB_API_KEY=replace_with_a_long_random_token
OPENAI_BASE_URL=
REQUEST_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=1200
